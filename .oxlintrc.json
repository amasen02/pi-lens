		"./vendor/stella/oxlint-plugins/runtime/no-raw-error-logging.js",
		"./vendor/stella/oxlint-plugins/runtime/no-raw-api-url.js",
		"./vendor/stella/oxlint-plugins/runtime/no-omitted-prop-respread.js",
		"./vendor/stella/oxlint-plugins/runtime/no-broad-translation-callable.js",
		"./vendor/stella/oxlint-plugins/runtime/no-facade-imports.js",
		"./vendor/stella/oxlint-plugins/runtime/require-stream-reader-disposal.js",
		"./vendor/stella/oxlint-plugins/runtime/require-fetch-timeout.js",
		"./vendor/stella/oxlint-plugins/runtime/require-eden-error-check.js",
		"./vendor/stella/oxlint-plugins/runtime/no-awaited-builder-union.js",
		"./vendor/stella/oxlint-plugins/runtime/no-coerced-optional-union-enum.js"
