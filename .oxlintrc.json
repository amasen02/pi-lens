{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
	"ignorePatterns": [
		"tests/fixtures/**"
	],
	"jsPlugins": [
		"./vendor/stella/oxlint-plugins/runtime/no-db-await-in-loop.js",
		"./vendor/stella/oxlint-plugins/runtime/no-object-url-leak.js",
		"./vendor/stella/oxlint-plugins/runtime/no-secret-in-log-sink.js",
